# ================================================================
# ePatient Environment Configuration
# ================================================================
# Copy this file to .env.local and fill in your actual values
# Never commit actual secrets to version control!

# ================================================================
# DATABASE CONFIGURATION
# ================================================================

# Local Development (SQLite)
DATABASE_URL="file:./dev.db"

# Production (Cloud SQL - PostgreSQL)
# DATABASE_URL="postgresql://username:password@/database_name?host=/cloudsql/project:region:instance"

# ================================================================
# AUTHENTICATION CONFIGURATION
# ================================================================

# Primary auth secret - MUST be at least 32 characters
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-32-character-secret-key-here-replace-this"

# Legacy NextAuth secret (fallback)
NEXTAUTH_SECRET="your-32-character-secret-key-here-replace-this"

# JWT-specific secret
JWT_SECRET="your-32-character-secret-key-here-replace-this"

# ================================================================
# DISCORD OAUTH CONFIGURATION
# ================================================================
# Create a Discord application at: https://discord.com/developers/applications
# Add redirect URI: http://localhost:3000/api/auth/callback/discord (for local)
# Add redirect URI: https://yourdomain.com/api/auth/callback/discord (for production)

AUTH_DISCORD_ID="your-discord-client-id-here"
AUTH_DISCORD_SECRET="your-discord-client-secret-here"

# ================================================================
# ENVIRONMENT CONFIGURATION
# ================================================================

# Application environment
NODE_ENV="development"

# Next.js URL (for production, use your actual domain)
# NEXTAUTH_URL="http://localhost:3000"

# ================================================================
# OPTIONAL: ADDITIONAL SERVICES
# ================================================================

# Google Cloud Project ID (for production deployment)
# GOOGLE_CLOUD_PROJECT="your-gcp-project-id"

# Cloud Storage bucket (if using file uploads)
# GOOGLE_CLOUD_STORAGE_BUCKET="your-storage-bucket"

# ================================================================
# DEVELOPMENT-ONLY SETTINGS
# ================================================================

# Skip environment validation (useful for Docker builds)
# SKIP_ENV_VALIDATION="true"

# Database logging (development only)
# DATABASE_LOGGING="true"

# ================================================================
# PRODUCTION-ONLY SETTINGS
# ================================================================

# Security headers and HTTPS enforcement
# FORCE_HTTPS="true"

# Session configuration
# SESSION_MAX_AGE="86400"  # 24 hours in seconds

# Rate limiting
# RATE_LIMIT_REQUESTS="100"
# RATE_LIMIT_WINDOW="900"  # 15 minutes in seconds

# ================================================================
# SETUP INSTRUCTIONS
# ================================================================
#
# 1. Copy this file: cp .env.example .env.local
# 2. Generate secure secrets:
#    - AUTH_SECRET: openssl rand -base64 32
#    - JWT_SECRET: openssl rand -base64 32
# 3. Create Discord OAuth app:
#    - Go to https://discord.com/developers/applications
#    - Create new application
#    - Go to OAuth2 section
#    - Copy Client ID and Client Secret
#    - Add redirect URI: http://localhost:3000/api/auth/callback/discord
# 4. Update database URL if needed
# 5. Save the file and restart your development server
#
# ================================================================