# ===========================================
# ePatients Application Environment Variables
# ===========================================
# Copy this file to .env.local and fill in your values
# For production, copy to .env.production

# ===========================================
# NODE ENVIRONMENT
# ===========================================
# Set to 'development', 'test', or 'production'
NODE_ENV="development"

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# Database connection URL
# For SQLite (development): file:./dev.db
# For PostgreSQL (production): postgresql://user:password@host:port/database
# For MySQL (production): mysql://user:password@host:port/database
DATABASE_URL="file:./dev.db"

# ===========================================
# AUTHENTICATION SECRETS
# ===========================================
# Primary authentication secret (minimum 32 characters)
# Generate with: openssl rand -base64 32
AUTH_SECRET="your_32_character_secret_here"

# NextAuth fallback secret (minimum 32 characters)
# Used as fallback if AUTH_SECRET is not set
NEXTAUTH_SECRET="your_32_character_nextauth_secret_here"

# JWT-specific secret (minimum 32 characters)
# Optional: separate secret for JWT tokens
JWT_SECRET="your_32_character_jwt_secret_here"

# ===========================================
# OAUTH PROVIDERS
# ===========================================
# Discord OAuth (optional)
# Get these from https://discord.com/developers/applications
DISCORD_CLIENT_ID="your_discord_client_id"
DISCORD_CLIENT_SECRET="your_discord_client_secret"

# GitHub OAuth (optional)
# Get these from https://github.com/settings/developers
GITHUB_CLIENT_ID="your_github_client_id"
GITHUB_CLIENT_SECRET="your_github_client_secret"

# Google OAuth (optional)
# Get these from https://console.developers.google.com/
GOOGLE_CLIENT_ID="your_google_client_id"
GOOGLE_CLIENT_SECRET="your_google_client_secret"

# ===========================================
# APPLICATION URLS
# ===========================================
# Base URL for the application
# Development: http://localhost:3000
# Production: https://yourdomain.com
NEXTAUTH_URL="http://localhost:3000"

# ===========================================
# DEVELOPMENT & DEBUGGING
# ===========================================
# Skip environment validation (useful for Docker builds)
# Set to 'true' to skip validation
SKIP_ENV_VALIDATION="false"

# Enable bundle analysis
# Set to 'true' to generate bundle analysis report
ANALYZE="false"

# ===========================================
# PRODUCTION SPECIFIC
# ===========================================
# Trust host for production deployments
# Set to 'true' in production
NEXTAUTH_TRUST_HOST="false"

# ===========================================
# SECURITY HEADERS
# ===========================================
# Content Security Policy (optional)
# CSP_NONCE="your_csp_nonce_here"

# ===========================================
# MONITORING & LOGGING
# ===========================================
# Sentry DSN for error tracking (optional)
# SENTRY_DSN="your_sentry_dsn_here"

# Log level for application logging
# Options: 'error', 'warn', 'info', 'debug'
LOG_LEVEL="info"

# ===========================================
# CACHE & PERFORMANCE
# ===========================================
# Redis URL for caching (optional)
# REDIS_URL="redis://localhost:6379"

# ===========================================
# EMAIL CONFIGURATION (if needed)
# ===========================================
# SMTP configuration for email notifications
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your_email@gmail.com"
# SMTP_PASSWORD="your_app_password"
# SMTP_FROM="your_email@gmail.com"

# ===========================================
# FILE UPLOAD (if needed)
# ===========================================
# Maximum file size for uploads (in bytes)
# MAX_FILE_SIZE="10485760" # 10MB

# Upload directory
# UPLOAD_DIR="./uploads"

# ===========================================
# API RATE LIMITING (if needed)
# ===========================================
# Rate limiting configuration
# RATE_LIMIT_MAX="100"
# RATE_LIMIT_WINDOW="900000" # 15 minutes in milliseconds

# ===========================================
# NOTES
# ===========================================
# 1. Never commit the actual .env file to version control
# 2. Generate strong, unique secrets for production
# 3. Use environment-specific files (.env.local, .env.production)
# 4. Restart the application after changing environment variables
# 5. For production, use a secure secret management service
