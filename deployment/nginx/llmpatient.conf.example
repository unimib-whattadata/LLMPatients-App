map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
}

server {
    listen 80;
    server_name llmpatient.whattadata.it;

    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl http2;
    server_name llmpatient.whattadata.it;

    ssl_certificate /etc/letsencrypt/live/llmpatient.whattadata.it/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/llmpatient.whattadata.it/privkey.pem;

    location / {
        proxy_pass http://149.132.178.114:8080;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_read_timeout 65s;
        proxy_connect_timeout 5s;
        proxy_send_timeout 65s;
    }
}
